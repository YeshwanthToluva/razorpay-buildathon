# Copy to .env and fill in. .env is gitignored -- never commit credentials.
AFIN_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agent_finance

# Comma-separated profile names. Each needs AFIN_LLM_<NAME>_{API_KEY,BASE_URL,MODEL}.
# The model is an experiment dimension: two runs may differ only by --profile.
AFIN_LLM_PROFILES=gpt,nema,glm,minimax,nemotron,gemma

AFIN_LLM_GPT_API_KEY=
AFIN_LLM_GPT_BASE_URL=https://litellm.aiplanet.com/v1
AFIN_LLM_GPT_MODEL=gpt-5.4-mini

AFIN_LLM_NEMA_API_KEY=
AFIN_LLM_NEMA_BASE_URL=https://gateway.platform.aiplanet.com/v1
AFIN_LLM_NEMA_MODEL=nema


# OpenRouter (free tier)
AFIN_LLM_GLM_API_KEY=
AFIN_LLM_GLM_BASE_URL=https://openrouter.ai/api/v1
AFIN_LLM_GLM_MODEL=z-ai/glm-5.2:free
AFIN_LLM_MINIMAX_API_KEY=
AFIN_LLM_MINIMAX_BASE_URL=https://openrouter.ai/api/v1
AFIN_LLM_MINIMAX_MODEL=minimax/minimax-m3:free
AFIN_LLM_NEMOTRON_API_KEY=
AFIN_LLM_NEMOTRON_BASE_URL=https://openrouter.ai/api/v1
AFIN_LLM_NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AFIN_LLM_GEMMA_API_KEY=
AFIN_LLM_GEMMA_BASE_URL=https://openrouter.ai/api/v1
AFIN_LLM_GEMMA_MODEL=google/gemma-4-31b-it:free

