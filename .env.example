# Copy to .env and fill in. .env is gitignored -- never commit credentials.
AFIN_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/agent_finance

# LLM credentials are grouped into named profiles, so the model is an experiment
# dimension: two runs may differ only by --profile and stay comparable.
# Each profile needs AFIN_LLM_<NAME>_{API_KEY,BASE_URL,MODEL}.
AFIN_LLM_PROFILES=primary

AFIN_LLM_PRIMARY_API_KEY=
# Any OpenAI-compatible endpoint. Include the /v1 segment.
AFIN_LLM_PRIMARY_BASE_URL=https://your-gateway.example.com/v1
AFIN_LLM_PRIMARY_MODEL=your-model-name

# Optional per-profile settings:
#   API_STYLE             chat_completions (default) or responses
#   TEMPERATURE           omitted entirely unless set
#   REASONING_EFFORT      omitted entirely unless set
#   MIN_INTERVAL_SECONDS  client-side pacing for rate-limited endpoints
# AFIN_LLM_PRIMARY_API_STYLE=chat_completions
# AFIN_LLM_PRIMARY_TEMPERATURE=0.0
# AFIN_LLM_PRIMARY_MIN_INTERVAL_SECONDS=2.0
